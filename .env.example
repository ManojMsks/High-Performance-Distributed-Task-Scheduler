# -----------------------------------------------------------------------------
# Distributed Task Scheduler — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# -----------------------------------------------------------------------------

# -- Application --------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
LOG_DIR=logs
PORT=3000

# -- PostgreSQL ----------------------------------------------------------------
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=scheduler_secret
POSTGRES_DB=task_scheduler
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# -- Redis ---------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# -- Scheduler Tuning ----------------------------------------------------------
# How often (ms) the scheduler polls for delayed tasks ready to be promoted
SCHEDULER_POLL_INTERVAL_MS=1000
# Max tasks promoted from delayed ZSET per scheduler tick
SCHEDULER_BATCH_SIZE=100
# How often (ms) the recovery scheduler checks for stale/orphaned tasks
RECOVERY_POLL_INTERVAL_MS=30000
# A task is considered stale if lockedAt is older than this many seconds
STALE_LOCK_THRESHOLD_SECONDS=90

# -- Worker Tuning -------------------------------------------------------------
# Number of tasks a single worker processes concurrently
WORKER_CONCURRENCY=5
# Blocking XREADGROUP timeout (ms) — how long a worker waits for new tasks
WORKER_BLOCK_TIMEOUT_MS=5000
# Heartbeat emission interval (ms)
WORKER_HEARTBEAT_INTERVAL_MS=10000
